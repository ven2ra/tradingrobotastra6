T_INVEST_TOKEN=
# Leave T_INVEST_INSTRUMENTS empty to auto-discover the liquid MOEX universe
# (TQBR shares + TQOB/TQCB bonds, filtered by T-Invest's own liquidity_flag),
# capped at T_INVEST_MAX_INSTRUMENTS. Set it to pin an explicit comma-separated
# TICKER_BOARD list instead, e.g. SBER_TQBR,LKOH_TQBR,YDEX_TQBR,GAZP_TQBR.
T_INVEST_INSTRUMENTS=
T_INVEST_MAX_INSTRUMENTS=300
T_INVEST_POLL_SECONDS=15
# Concurrent T-Invest HTTP requests in flight; raise cautiously to avoid 429s.
T_INVEST_CONCURRENCY=3

# Optional: T-Invest account UID to prefer when GetAccounts returns several.
T_INVEST_ACCOUNT_ID=

# Set this to enable the in-app "Настройки T-Invest" form (token + instrument
# cap, edited from the browser instead of this file). Leave empty to disable
# the form entirely — with no password set, the settings endpoints refuse to
# write anything. Pick a long random value; anyone with it can replace your
# token from the UI.
ADMIN_PASSWORD=
